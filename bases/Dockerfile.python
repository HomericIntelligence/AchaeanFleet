# AchaeanFleet Base Image: Python
#
# Provides: python:3.12-slim + Node.js 20 + tmux + zsh + git
# Python-based agent vessels (Aider) FROM this.

# Node.js 20 source stage — binary copied into runtime, no external scripts
FROM node:26-slim@sha256:14bf3eac4bf209d906d3c41256597d3ab1f926b2e93a79e9bdfe1efd32454239 AS node-source

FROM python:3.14-slim@sha256:656d12e70054d5fda18a045e2494c96701e9792dd1445f95b3d038df954f57e9

LABEL org.opencontainers.image.title="achaean-base-python"
LABEL org.opencontainers.image.description="AchaeanFleet Python base image for AI agent containers"
LABEL org.opencontainers.image.source="https://github.com/HomericIntelligence/AchaeanFleet"

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION
ARG GIT_SHA=unknown
LABEL org.opencontainers.image.created=${BUILD_DATE}
LABEL org.opencontainers.image.revision=${VCS_REF}
LABEL org.opencontainers.image.version=${VERSION}
LABEL git-sha=${GIT_SHA}

# Install system dependencies and apply security patches.
# `apt-get upgrade` is required because the upstream python:3.14-slim base
# image lags behind Debian security updates (e.g. CVE-2026-4878 libcap2,
# CVE-2026-29111 libsystemd0/libudev1) and the trivy gate fails on any
# HIGH/CRITICAL CVE with a fixed version available.
# curl: required by Oh My Zsh installer in common-setup.sh
RUN apt-get update && apt-get upgrade -y && apt-get install -y \
    curl \
    wget \
    git \
    tmux \
    zsh \
    vim \
    nano \
    procps \
    ca-certificates \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy Node.js binary and npm from the node-source stage (no external scripts)
COPY --from=node-source /usr/local/bin/node /usr/local/bin/node
COPY --from=node-source /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -sf ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx && \
    chmod +x /usr/local/lib/node_modules/npm/bin/npm-cli.js \
             /usr/local/lib/node_modules/npm/bin/npx-cli.js

# BEGIN GENERATED TOOL PINS (source: versions.yml)
ENV CERTIFI_VERSION=2026.10.18
ENV MSGPACK_VERSION=1.2.3
ENV NPM_VERSION=11.21.2
ENV PIP_VERSION=26.3
ENV SETUPTOOLS_VERSION=83.0.0
ENV YARN_VERSION=1.22.22
# END GENERATED TOOL PINS

# npm is re-pinned above the copy bundled in the digest-pinned node base,
# because npm's bundled dependencies are themselves trivy-gated. The version is
# in the generated block above; the floor is set by these advisories:
#   picomatch >= 4.0.4   CVE-2026-33671
#   sigstore >= 4.1.1    CVE-2026-48815
#   tar >= 7.5.21        CVE-2026-73566
#   undici >= 6.29.1     CVE-2026-109383 / CVE-2026-109869 / CVE-2026-87018
# npm 11.19.x ships undici 6.28.0, which fails the base-image trivy gate.
RUN npm install -g npm@${NPM_VERSION}

# Install Yarn
RUN npm install -g yarn@${YARN_VERSION}

# Create non-root user
ARG USER_ID=1000
ARG GROUP_ID=1000
RUN groupadd -g ${GROUP_ID} agent && \
    useradd -l -m -u ${USER_ID} -g agent -s /bin/zsh agent && \
    echo "agent ALL=(ALL) NOPASSWD: /usr/bin/tmux, /usr/bin/git" >> /etc/sudoers

# Configure tmux
RUN mkdir -p /home/agent && \
    echo "set -g mouse on" >> /home/agent/.tmux.conf && \
    echo "set -g history-limit 50000" >> /home/agent/.tmux.conf && \
    echo "set -g status-bg colour235" >> /home/agent/.tmux.conf && \
    echo "set -g status-fg colour136" >> /home/agent/.tmux.conf && \
    chown -R agent:agent /home/agent

# Install Oh My Zsh from a pinned commit (reproducible, no curl|bash)
ENV OHMYZSH_COMMIT=7c10d9839f05b8b73e26aa4e0f04cc886fbba6a6
USER agent
RUN git clone https://github.com/ohmyzsh/ohmyzsh.git /home/agent/.oh-my-zsh && \
    git -C /home/agent/.oh-my-zsh checkout "$OHMYZSH_COMMIT" && \
    cp /home/agent/.oh-my-zsh/templates/zshrc.zsh-template /home/agent/.zshrc
USER root

COPY bases/scripts/strip-setuid.sh /tmp/strip-setuid.sh
RUN bash /tmp/strip-setuid.sh && rm /tmp/strip-setuid.sh

# pip IS re-pinned, upward. trivy also reads pip's own vendored copies
# (pip/_vendor/vendor.txt), so the site-packages pins below cannot clear
# findings that live inside pip: the bundled pip 26.2.1 vendors certifi
# 2026.6.17 (GHSA-6q48-6c7w-9gw2) and msgpack 1.1.2 (CVE-2026-114613).
# pip 26.3 vendors certifi 2026.10.23 and msgpack 1.2.4, above both fixed
# versions. This is an upgrade from the bundled 26.2.1, not a downgrade — the
# Errno 39 self-replacement race seen here previously came from pinning DOWN
# to 26.0.1 and does not reproduce on the upgrade (verified against the
# digest-pinned base image). See vessels/aider/Dockerfile for the 3.12 case.
RUN python -m pip install --no-cache-dir --upgrade pip==${PIP_VERSION}

# Security bumps for packages preinstalled in the pinned python:3.14-slim
# digest. The version values come from the generated block above; this comment
# records why each one is above what the base image ships:
#   - certifi 2026.6.17 -> 2026.10.18  GHSA-6q48-6c7w-9gw2 (CRITICAL: the
#     bundled CA store contains compromised emSign roots)
#   - msgpack 1.1.2 -> 1.2.3           GHSA-6v7p-g79w-8964 (OOB read on
#     unpacker reuse) and CVE-2026-114613 (memory-leak DoS)
#   - setuptools 70.3.0 -> 83.0.0      CVE-2025-47273 path traversal,
#     CVE-2026-59890 runtime fork protection; drops vendored jaraco.context
#     (CVE-2026-23949) and vendors wheel 0.46.3 (CVE-2026-24049 fixed 0.46.2)
RUN pip install --no-cache-dir certifi==${CERTIFI_VERSION} msgpack==${MSGPACK_VERSION} setuptools==${SETUPTOOLS_VERSION}

COPY bases/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /workspace

ENV AGENT_ID=agent-local
ENV TMUX_SESSION_NAME=agent-session
ENV WORKSPACE=/workspace
ENV AGENT_PORT=23001
ENV GIT_USER_NAME="HomericIntelligence Agent"
ENV GIT_USER_EMAIL="agent@HomericIntelligence.ai"

USER agent

ENTRYPOINT ["/entrypoint.sh"]
