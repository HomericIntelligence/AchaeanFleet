# AchaeanFleet Base Image: Node.js
#
# Provides: node:20-slim + tmux + zsh + git
# Compatible with the HomericIntelligence agent mesh.
# All node-based agent vessels (Claude, Codex, Cline, Codebuff, AmpCode) FROM this.
#
# Digest pinned: run scripts/pin-digests.sh to refresh when bumping base image versions.

FROM node:26-slim@sha256:4ebb5ace66f15a24c14c492e01a8beeed4fddf970a856109f5126e703e5fe503

LABEL org.opencontainers.image.title="achaean-base-node"
LABEL org.opencontainers.image.description="AchaeanFleet Node.js base image for AI agent containers"
LABEL org.opencontainers.image.source="https://github.com/HomericIntelligence/AchaeanFleet"
LABEL org.opencontainers.image.revision=$GIT_SHA
LABEL org.opencontainers.image.version=$VERSION
LABEL git-sha=$GIT_SHA

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION
LABEL org.opencontainers.image.created=${BUILD_DATE}
LABEL org.opencontainers.image.revision=${VCS_REF}
LABEL org.opencontainers.image.version=${VERSION}

USER root

# Upgrade npm to get picomatch>=4.0.4 (CVE-2026-33671 fix) and
# sigstore>=4.1.1 (CVE-2026-48815 fix)
RUN npm install -g npm@11.18.0

# Install system dependencies and apply security patches
RUN apt-get update && apt-get upgrade -y && apt-get install -y \
    curl \
    wget \
    git \
    tmux \
    zsh \
    vim \
    nano \
    procps \
    ca-certificates \
    build-essential \
    python3 \
    && rm -rf /var/lib/apt/lists/*

# npm still bundles tar 7.5.19; pin its compatible security update until npm
# includes the CVE-2026-73566 fix. Preserve npm's other bundled dependencies.
ENV NPM_TAR_VERSION=7.5.21
ARG NPM_TAR_SHA256=bcedf25a21daecd1a18fb5e19ab855b7d79ec8ef1da175e8ba85cfc0ed0069d1
RUN curl -fsSL --retry 3 "https://registry.npmjs.org/tar/-/tar-${NPM_TAR_VERSION}.tgz" -o /tmp/npm-tar.tgz \
    && echo "${NPM_TAR_SHA256}  /tmp/npm-tar.tgz" | sha256sum --check \
    && mkdir /tmp/npm-tar \
    && tar -xzf /tmp/npm-tar.tgz -C /tmp/npm-tar \
    && node -e 'const before=require("/usr/local/lib/node_modules/npm/node_modules/tar/package.json");const after=require("/tmp/npm-tar/package/package.json");if(after.version!==process.env.NPM_TAR_VERSION||JSON.stringify(before.dependencies)!==JSON.stringify(after.dependencies))throw Error("npm tar dependency contract changed")' \
    && rm -rf /usr/local/lib/node_modules/npm/node_modules/tar \
    && mv /tmp/npm-tar/package /usr/local/lib/node_modules/npm/node_modules/tar \
    && rm -rf /tmp/npm-tar /tmp/npm-tar.tgz \
    && node -e 'const tar=require("/usr/local/lib/node_modules/npm/node_modules/tar");if(typeof tar.create!=="function"||typeof tar.extract!=="function")throw Error("npm tar load failed")'

# node:20-slim ships with user 'node' (UID 1000). Rename to 'agent' for convention.
# Narrow sudo to the specific commands agents actually need instead of ALL.
RUN usermod -l agent -d /home/agent -m node && \
    groupmod -n agent node && \
    echo "agent ALL=(ALL) NOPASSWD: /usr/bin/tmux, /usr/bin/git" >> /etc/sudoers

# Configure tmux
RUN mkdir -p /home/agent && \
    echo "set -g mouse on" >> /home/agent/.tmux.conf && \
    echo "set -g history-limit 50000" >> /home/agent/.tmux.conf && \
    echo "set -g status-bg colour235" >> /home/agent/.tmux.conf && \
    echo "set -g status-fg colour136" >> /home/agent/.tmux.conf && \
    chown -R agent:agent /home/agent

# Install Oh My Zsh from a pinned commit (reproducible, no curl|bash)
ENV OHMYZSH_COMMIT=7c10d9839f05b8b73e26aa4e0f04cc886fbba6a6
USER agent
RUN git clone https://github.com/ohmyzsh/ohmyzsh.git /home/agent/.oh-my-zsh && \
    git -C /home/agent/.oh-my-zsh checkout "$OHMYZSH_COMMIT" && \
    cp /home/agent/.oh-my-zsh/templates/zshrc.zsh-template /home/agent/.zshrc
USER root

COPY bases/scripts/strip-setuid.sh /tmp/strip-setuid.sh
RUN bash /tmp/strip-setuid.sh && rm /tmp/strip-setuid.sh

# Create workspace and app directories
RUN mkdir -p /workspace /app && \
    chown -R agent:agent /workspace /app

WORKDIR /workspace

ENV AGENT_ID=agent-local
ENV TMUX_SESSION_NAME=agent-session
ENV WORKSPACE=/workspace
ENV AGENT_PORT=23001
ENV GIT_USER_NAME="HomericIntelligence Agent"
ENV GIT_USER_EMAIL="agent@HomericIntelligence.ai"


COPY bases/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

USER agent

ENTRYPOINT ["/entrypoint.sh"]
