# AchaeanFleet Vessel: Hermes — NATS event hub / message bus service
#
# Ported from HomericIntelligence/Hermes (Dockerfile). The source is cloned at
# a pinned upstream commit so this vessel tracks the canonical component repo;
# bump UPSTREAM_SHA after upstream merges that should ship in the fleet image.
#
# Runtime: python:3.13-slim (matches Hermes's requirements.lock.txt, generated
# with pip-compile --generate-hashes against Python 3.13 — see Hermes #354).

ARG UPSTREAM_SHA=c89b52ae41f6
ARG UPSTREAM_REPO=https://github.com/HomericIntelligence/Hermes

# -- Builder: resolve the hashed dependency set --------------------------------
FROM python:3.13-slim@sha256:6771159cd4fa5d9bba1258caf0b82e6b73458c694d178ad97c5e925c2d0e1a91 AS builder
ARG UPSTREAM_SHA
ARG UPSTREAM_REPO
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN git clone -q ${UPSTREAM_REPO} /src \
    && git -C /src checkout -q ${UPSTREAM_SHA}

WORKDIR /build
# requirements.lock.txt is generated by `just lock` (pip-compile --generate-hashes)
# against Python 3.13 to match the runtime interpreter; --require-hashes makes
# pip refuse any unpinned transitive, guaranteeing reproducible builds.
RUN pip install --no-cache-dir --require-hashes --target /build/deps -r /src/requirements.lock.txt

# -- Runtime -------------------------------------------------------------------
FROM python:3.13-slim@sha256:6771159cd4fa5d9bba1258caf0b82e6b73458c694d178ad97c5e925c2d0e1a91

LABEL org.opencontainers.image.title="achaean-hermes"
LABEL org.opencontainers.image.description="Hermes NATS event hub — fleet message bus service"

WORKDIR /app

# tini for PID-1 signal forwarding; curl for the HEALTHCHECK.
RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends tini curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/deps /usr/local/lib/python3.13/site-packages/
COPY --from=builder /src/src/hermes/ ./hermes/

RUN useradd -r -s /usr/sbin/nologin hermes
USER hermes

ENV HERMES_HOST=0.0.0.0
ENV HERMES_PORT=8085
ENV HERMES_PUBLIC_URL=http://localhost:8085
ENV PYTHONDONTWRITEBYTECODE=1
EXPOSE 8085

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:${HERMES_PORT:-8085}/ready || exit 1

ENTRYPOINT ["tini", "--"]
CMD ["python", "-m", "hermes.server"]
