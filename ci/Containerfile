# Native amd64/arm64 CI tools. The project environment is installed from pixi.lock.
FROM node:26-slim@sha256:4ebb5ace66f15a24c14c492e01a8beeed4fddf970a856109f5126e703e5fe503 AS node
FROM python:3.13-slim@sha256:6771159cd4fa5d9bba1258caf0b82e6b73458c694d178ad97c5e925c2d0e1a91

LABEL org.opencontainers.image.title="achaeanfleet-ci"
LABEL org.opencontainers.image.description="Native bounded AchaeanFleet CI tools"
LABEL org.opencontainers.image.source="https://github.com/HomericIntelligence/AchaeanFleet"
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    git curl ca-certificates make jq yamllint shellcheck bats libatomic1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

ARG TARGETARCH
COPY ci/install_tools.py ci/tool-artifacts.json /opt/ci-install/
RUN python /opt/ci-install/install_tools.py --platform "linux/${TARGETARCH}" \
      --artifacts /opt/ci-install/tool-artifacts.json --destination /usr/local/bin \
    && pixi --version && just --version && hadolint --version \
    && test "$(gitleaks version)" = '8.30.1' \
    && docker-compose version && trivy --version && nomad version

COPY ci/package.json ci/package-lock.json /opt/ci-tools/
RUN cd /opt/ci-tools && npm ci --ignore-scripts --omit=dev \
    && ln -s /opt/ci-tools/node_modules/.bin/markdownlint-cli2 /usr/local/bin/markdownlint-cli2 \
    && markdownlint-cli2 --version \
    && groupadd --gid 1000 ci \
    && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash ci \
    && mkdir -p /home/ci/.cache && chown -R 1000:1000 /home/ci
WORKDIR /workspace
USER 1000:1000
