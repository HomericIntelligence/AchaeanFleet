# Containerfile for achaeanfleet-ci — CI image for AchaeanFleet.
#
# Provides:
# - Python 3.13 base + pixi v0.70.2 (pinned release, checksum-verified)
# - Native AMD64/ARM64 lint, test, schema and security tools
# - Non-root user 'ci' (uid 1000) for rootless Podman compatibility
#
# The locked pixi project environment is NOT baked in: the repo is mounted at
# /workspace at runtime and the env lives under /workspace/.pixi (gitignored).
# run_ci_local.sh mounts a persistent host pixi cache (~/.cache/pixi) so
# 'pixi install --locked' is fast on warm runs.
#
# Build (OCI-compliant — works with both podman and docker):
#   podman build --ignorefile ci/.dockerignore -f ci/Containerfile -t achaeanfleet-ci:local .
#   docker build -f ci/Containerfile -t achaeanfleet-ci:local .

# ============================================================================
# Stage 0: pixi binary — pinned GitHub release, checksum-verified
# ============================================================================
FROM node:22-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9 AS node

FROM python:3.13-slim@sha256:6771159cd4fa5d9bba1258caf0b82e6b73458c694d178ad97c5e925c2d0e1a91 AS pixi

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN set -eu; \
    case "$(dpkg --print-architecture)" in \
        amd64) machine=x86_64; digest=9d0d72fc1fa1a8f87bfde943cf25d3575cb352cb516795d4dab21898bd98adea ;; \
        arm64) machine=aarch64; digest=19f61d069f7ab963f3b9d6794134f893c83ecd2b7cd698e19268daa3a1fa606b ;; \
        *) echo 'Unsupported CI architecture' >&2; exit 1 ;; \
    esac; \
    curl -fsSL --retry 5 --retry-all-errors "https://github.com/prefix-dev/pixi/releases/download/v0.70.2/pixi-${machine}-unknown-linux-musl.tar.gz" -o /tmp/pixi.tar.gz \
    && echo "${digest}  /tmp/pixi.tar.gz" | sha256sum --check \
    && tar xzf /tmp/pixi.tar.gz -C /usr/local/bin \
    && rm /tmp/pixi.tar.gz \
    && pixi --version

# ============================================================================
# Stage 1: Runtime — minimal image
# ============================================================================
FROM python:3.13-slim@sha256:6771159cd4fa5d9bba1258caf0b82e6b73458c694d178ad97c5e925c2d0e1a91

LABEL org.opencontainers.image.title="achaeanfleet-ci"
LABEL org.opencontainers.image.description="CI container for AchaeanFleet — linting, testing, security scans"
LABEL org.opencontainers.image.vendor="AchaeanFleet"
LABEL org.opencontainers.image.source="https://github.com/HomericIntelligence/AchaeanFleet"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    make \
    jq \
    yamllint \
    shellcheck \
    just \
    bats=1.11.1-1 \
    libatomic1 \
    libstdc++6 \
    unzip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=pixi /usr/local/bin/pixi /usr/local/bin/pixi
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm

RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && test "$(node --version)" = v22.23.2 \
    && test "$(npm --version)" = 10.9.8

# Native release artifacts: select and verify bytes before installation.
# UV matches the image integration's 0.12.10 pin. Hadolint matches hosted CI.
RUN set -eu; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
        amd64) \
            machine=x86_64; leaks_arch=x64; trivy_arch=64bit; hadolint_arch=x86_64; \
            uv_sha=173d95a0c32d18c896c46ba6fafbf3cf9c14ab74b033f81b76c883ef492a976b; \
            leaks_sha=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb; \
            trivy_sha=2ae6fe3ee734b7fdf11335663e18c75ea12dccc76062f09f164a3b0f8be4371a; \
            compose_sha=db1889184726840f75c4f9c001048430d4f25b3be3cb084d3ddd762bc0aed576; \
            hadolint_sha=eb8eb4dd06a068cce65cb84743fba69f09ed12a36ff13d58f9af090d6d696970; \
            nomad_sha=e9c7337893eceb549557ef9ad341b3ae64f5f43e29ff1fb167b70cfd16748d2d ;; \
        arm64) \
            machine=aarch64; leaks_arch=arm64; trivy_arch=ARM64; hadolint_arch=arm64; \
            uv_sha=9ff6b9d4665edcdd3a88dcc73cd1eb641754deb927f14e8c62ebfde6bf4f5f5e; \
            leaks_sha=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080; \
            trivy_sha=b94ce1976bbf3c15b514b605ee88be7c6d94a29be2302847ff01cb794d47aad5; \
            compose_sha=732e3a84c1a0f67256ce80bc2598a24546b10ca05f9faa97efceb1171ece2ef7; \
            hadolint_sha=17993abf41a0a4da7f2e08970b4f4baf3f95e5e79b9ac80ba6b2aac1960ca71c; \
            nomad_sha=30984d4d51a484995d9cdb5089a5a209b3332e11ab08caf179a32b9ba2e4227e ;; \
        *) echo 'Unsupported CI architecture' >&2; exit 1 ;; \
    esac; \
    download() { \
        curl -fsSL --retry 5 --retry-all-errors "$1" -o /tmp/ci-tool; \
        echo "$2  /tmp/ci-tool" | sha256sum --check; \
    }; \
    download "https://github.com/astral-sh/uv/releases/download/0.12.10/uv-${machine}-unknown-linux-gnu.tar.gz" "$uv_sha"; \
    tar -xzf /tmp/ci-tool -C /usr/local/bin --strip-components=1 \
        "uv-${machine}-unknown-linux-gnu/uv" "uv-${machine}-unknown-linux-gnu/uvx"; \
    download "https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_${leaks_arch}.tar.gz" "$leaks_sha"; \
    tar -xzf /tmp/ci-tool -C /usr/local/bin gitleaks; \
    download "https://github.com/aquasecurity/trivy/releases/download/v0.74.0/trivy_0.74.0_Linux-${trivy_arch}.tar.gz" "$trivy_sha"; \
    tar -xzf /tmp/ci-tool -C /usr/local/bin trivy; \
    download "https://github.com/docker/compose/releases/download/v5.5.1/docker-compose-linux-${machine}" "$compose_sha"; \
    install -m 0755 /tmp/ci-tool /usr/local/bin/docker-compose; \
    download "https://github.com/hadolint/hadolint/releases/download/v2.15.0/hadolint-linux-${hadolint_arch}" "$hadolint_sha"; \
    install -m 0755 /tmp/ci-tool /usr/local/bin/hadolint; \
    download "https://releases.hashicorp.com/nomad/1.9.7/nomad_1.9.7_linux_${arch}.zip" "$nomad_sha"; \
    unzip -p /tmp/ci-tool nomad > /usr/local/bin/nomad; \
    chmod 0755 /usr/local/bin/nomad; \
    rm /tmp/ci-tool; \
    pixi --version; uv --version; gitleaks version; trivy --version; \
    docker-compose version; nomad --version; hadolint --version; bats --version

COPY ci/package.json ci/package-lock.json /opt/ci-tools/
RUN npm ci --prefix /opt/ci-tools --ignore-scripts --omit=dev \
    && ln -s /opt/ci-tools/node_modules/.bin/markdownlint-cli2 /usr/local/bin/markdownlint-cli2 \
    && markdownlint-cli2 --version

# Create non-root user for rootless Podman compatibility
RUN groupadd -r ci && useradd -r -g ci -u 1000 -m -s /bin/bash ci \
    && mkdir -p /home/ci/.cache \
    && chown -R ci:ci /home/ci

WORKDIR /workspace

USER ci
